{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\server.js"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Client",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/pages", // Adjust this path to your React src directory 
            "sourceMaps": true, 
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            },
            "outFiles": [
                "${workspaceFolder}/.next/**/*.js"
            ],
        }
    ],
    "compounds": [
        {
            "name": "Launch App",
            "configurations": [
                "Launch Server",
                "Launch Client"
            ]
        }
    ]
}

